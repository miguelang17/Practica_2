    "    ax_log.set_title(f\"log10(1 + {c})\", fontsize=9)\n",
    "for ax in axs[:, [0, 2]].ravel():\n",
    "    ax.set_ylabel(\"patrones\")\n",
    "fig.suptitle(\"Características numéricas del entrenamiento: escala original (azul) y log10(1 + x) (verde)\")\n",
