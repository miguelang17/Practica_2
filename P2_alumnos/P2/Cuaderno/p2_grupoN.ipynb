    "from sklearn.model_selection import GroupKFold, KFold\n",
    "\n",
    "# Identificador de grupo: cada configuración única de hardware/carga (1.000 grupos)\n",
    "cols_config = [c for c in X_LATENCIA]\n",
    "grupos_latencia = latencia_train.groupby(cols_config, dropna=False).ngroup()\n",
    "\n",
    "# Métrica oficial de la competición: error absoluto medio en log10(latency_ns)\n",
    "def mae_log(y_true, y_pred):\n",
    "  y_true = np.asarray(y_true, dtype=float)\n",
    "  y_pred = np.asarray(y_pred, dtype=float)\n",
    "  assert np.all(y_true > 0) and np.all(y_pred > 0), (\n",
    "      \"y_true y y_pred deben ser positivos\"\n",
    "  )\n",
    "  return float(np.mean(np.abs(np.log10(y_true) - np.log10(y_pred))))\n",
    "\n",
    "\n",
    "# Esquemas de validación candidatos (K = 5 particiones)\n",
    "cv_agrupada = GroupKFold(n_splits=5)\n",
    "cv_aleatoria = KFold(n_splits=5, shuffle=True, random_state=SEMILLA)\n",
    "\n",
    "# Comprobación de solapamiento de configuraciones entre train y validación\n",
    "solap_agrupada = []\n",
    "solap_aleatoria = []\n",
    "\n",
    "for tr_idx, va_idx in cv_agrupada.split(\n",
    "    latencia_train, latencia_train[\"latency_ns\"], groups=grupos_latencia\n",
    "):\n",
    "  solap_agrupada.append(\n",
    "      len(\n",
    "          set(grupos_latencia.iloc[tr_idx]) & set(grupos_latencia.iloc[va_idx])\n",
    "      )\n",
    "  )\n",
    "\n",
    "for tr_idx, va_idx in cv_aleatoria.split(latencia_train):\n",
    "  solap_aleatoria.append(\n",
    "      len(\n",
    "          set(grupos_latencia.iloc[tr_idx]) & set(grupos_latencia.iloc[va_idx])\n",
    "      )\n",
    "  )\n",
    "\n",
    "print(\n",
    "    \"Configuraciones compartidas train/val por fold (GroupKFold, K=5):\",\n",
    "    solap_agrupada,\n",
    ")\n",
    "print(\n",
    "    \"Configuraciones compartidas train/val por fold (KFold por filas, K=5):\",\n",
    "    solap_aleatoria,\n",
    ")"
   ]
  },
