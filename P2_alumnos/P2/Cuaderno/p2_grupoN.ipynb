       "5   6   0.118549   0.006347    0.232904    0.005931\n",
       "6   7   0.134283   0.006020    0.225574    0.004778\n",
       "7   8   0.143141   0.005482    0.223872    0.005284\n",
       "8   9   0.148154   0.005357    0.225288    0.006229\n",
