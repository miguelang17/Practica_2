    "from sklearn.model_selection import KFold, StratifiedKFold\n",
    "\n",
    "CLASES_RARAS = [\"ransomware\", \"backdoor\", \"mitm\"]\n",
    "X_c = ciber_train[X_CIBER]\n",
    "\n",
    "filas = []\n",
    "for nombre, cv in [(\"KFold\", KFold(n_splits=5, shuffle=True, random_state=SEMILLA)),\n",
    "                   (\"StratifiedKFold\", StratifiedKFold(n_splits=5, shuffle=True, random_state=SEMILLA))]:\n",
    "    for q, (_, idx_val) in enumerate(cv.split(X_c, y_ciber), start=1):\n",
    "        cuenta = y_ciber.iloc[idx_val].value_counts()\n",
    "        filas.append({\"esquema\": nombre, \"partición\": q, **{c: cuenta.get(c, 0) for c in CLASES_RARAS}})\n",
    "\n",
    "reparto = pd.DataFrame(filas).set_index([\"esquema\", \"partición\"])\n",
    "display(reparto)\n",
    "display(reparto.groupby(\"esquema\").agg([\"min\", \"max\"]))"
   ]
