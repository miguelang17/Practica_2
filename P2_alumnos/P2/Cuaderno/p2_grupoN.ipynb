    "# Cuánto varían las cinco ejecuciones de una misma configuración\n",
    "\n",
    "# Se definen las columnas que representan la \"configuración\" (todas menos 'id' y 'latency_ns')\n",
    "configuracion = [c for c in latencia_train.columns if c not in ['id', 'latency_ns']]\n",
    "\n",
    "grupos_lat = latencia_train.groupby(configuracion)[\"latency_ns\"]\n",
    "ratio_max_min = grupos_lat.max() / grupos_lat.min()\n",
    "std_log10 = grupos_lat.apply(lambda s: np.log10(s).std(ddof=1))\n",
    "\n",
    "resumen_var = pd.DataFrame({\n",
    "    \"ratio_max_min\": ratio_max_min,\n",
    "    \"std_log10_ns\": std_log10,\n",
    "})\n",
    "print(\"Resumen de variabilidad entre las 5 ejecuciones (1.000 configuraciones):\")\n",
    "display(\n",
    "    resumen_var.describe(percentiles=[0.25, 0.5, 0.75, 0.9]).T[[\n",
    "        \"count\",\n",
    "        \"mean\",\n",
    "        \"std\",\n",
    "        \"min\",\n",
    "        \"25%\",\n",
